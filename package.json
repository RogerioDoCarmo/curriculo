{
  "name": "personal-resume-website",
  "version": "1.9.3",
  "private": true,
  "description": "A modern, responsive personal resume website built with Next.js 16, TypeScript, and Tailwind CSS",
  "author": "Rogério do Carmo",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "serve": "npx serve@latest out -l 3000",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 300",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration",
    "test:e2e": "time playwright test",
    "test:e2e:chromium": "time playwright test --project=chromium",
    "test:e2e:headed": "time playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:lighthouse": "jest --testPathIgnorePatterns=node_modules --testPathPatterns=tests/lighthouse",
    "test:lighthouse:full": "npm run build && npm run serve & sleep 5 && npm run test:lighthouse; kill $!",
    "test:properties": "jest --testPathIgnorePatterns=node_modules --testPathPatterns=tests/properties",
    "test:mutation": "stryker run",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic:publish": "npm run build-storybook && npx chromatic --storybook-build-dir=storybook-static",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.50.0",
    "autoprefixer": "^10.x",
    "firebase": "^12.12.1",
    "js-yaml": "^4.2.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.9",
    "next-intl": "^4.9.2",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.x",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.x",
    "zod": "^4.x"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-storybook": "^10.3.5",
    "fast-check": "^4.8.0",
    "firebase-admin": "^13.8.0",
    "husky": "^9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^17",
    "playwright": "^1.59.1",
    "prettier": "^3",
    "storybook": "^10.3.5",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "overrides": {
    "@tootallnate/once": ">=3.0.1",
    "postcss": ">=8.5.10",
    "uuid": ">=11.1.1",
    "qs": ">=6.15.2",
    "esbuild": "~0.28.1",
    "@vitest/browser": ">=4.1.8",
    "js-yaml": "^4.2.0",
    "@firebase/firestore": {
      "@grpc/grpc-js": "~1.9.16"
    },
    "google-gax": {
      "@grpc/grpc-js": "~1.14.4"
    }
  }
}
