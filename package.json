{
  "name": "personal-resume-website",
  "version": "1.23.1",
  "private": true,
  "description": "A modern, responsive personal resume website built with Next.js 16, TypeScript, and Tailwind CSS",
  "author": "Rogério do Carmo",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "serve": "npx serve@latest out -l 3000",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 300",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration",
    "test:e2e": "time playwright test",
    "test:e2e:chromium": "time playwright test --project=chromium",
    "test:e2e:chromatic": "playwright test tests/e2e/chromatic.spec.ts --project=chromium",
    "test:e2e:headed": "time playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:lighthouse": "jest --testPathIgnorePatterns=node_modules --testPathPatterns=tests/lighthouse",
    "test:lighthouse:full": "bash scripts/test-lighthouse-full.sh",
    "test:properties": "jest --testPathIgnorePatterns=node_modules --testPathPatterns=tests/properties",
    "test:mutation": "stryker run",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic:publish": "npm run build-storybook && npx chromatic --storybook-build-dir=storybook-static",
    "chromatic:playwright": "npm run test:e2e:chromatic && npx chromatic --playwright --exit-zero-on-changes",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "resume-editor": "node docs/personal-notes/career/editor-server.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitest/mocker": "^5.0.3",
    "autoprefixer": "^10.x",
    "fast-uri": "^3.1.8",
    "firebase": "^12.19.0",
    "js-yaml": "^5.4.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.x",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.x",
    "zod": "^4.x"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^1.0.0",
    "@chromatic-com/storybook": "^5.4.0",
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "1.61.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-storybook": "^10.6.1",
    "fast-check": "^4.10.2",
    "firebase-admin": "^14.5.0",
    "husky": "^9",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17",
    "playwright": "1.61.0",
    "prettier": "^3",
    "storybook": "^10.6.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.12.1",
  "overrides": {
    "@tootallnate/once": ">=3.0.1",
    "postcss": ">=8.5.18",
    "uuid": ">=11.1.1",
    "qs": ">=6.16.0",
    "esbuild": "~0.28.2",
    "@vitest/browser": "~5.0.3",
    "js-yaml": "^5.4.2",
    "fast-uri": "^3.1.8",
    "sharp": ">=0.35.5",
    "brace-expansion": ">=5.0.12",
    "@firebase/firestore": {
      "@grpc/grpc-js": "~1.14.5"
    },
    "google-gax": {
      "@grpc/grpc-js": "~1.14.5"
    }
  }
}
